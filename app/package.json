{
  "name": "cv",
  "version": "1.2.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "build": "node scripts/build-docs.mjs",
    "preview": "node scripts/serve.mjs 4300",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && ngc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint src e2e",
    "test": "ng test --no-watch",
    "test:coverage": "ng test --no-watch --coverage --coverage-reporters=lcov --coverage-reporters=text-summary --coverage-include=\"src/app/core/**/*.ts\" --coverage-include=\"src/app/graph/**/*.ts\" --coverage-include=\"src/app/content/**/*.ts\" --coverage-include=\"src/app/search/search.ts\" --coverage-include=\"src/app/search/assistant.ts\" --coverage-include=\"src/app/sections/uses.ts\" --coverage-exclude=\"**/*.spec.ts\"",
    "check:contrast": "node scripts/check-contrast.mjs",
    "portrait": "node scripts/portrait.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "check:privacy": "node scripts/verify-privacy.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "lighthouse": "node scripts/lighthouse-gate.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "angular-eslint": "^22.6.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
